{
    "name": "jjpeleato/wp-starter-boilerplate",
    "description": "WordPress base repository for any project.",
    "keywords": [
		"WordPress",
		"WordPress Coding Standard",
		"psr1",
		"psr12",
		"lando",
		"deployer"
	],
    "homepage": "https://github.com/jjpeleato/wp-starter-boilerplate.git",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "José J. Peleato Pradel",
            "homepage": "https://www.jjpeleato.com/"
		}
    ],
    "require": {
        "php": "^8.3",
		"ext-json": "*"
    },
    "require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"deployer/deployer": "^7.5",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"roave/security-advisories": "dev-latest",
		"squizlabs/php_codesniffer": "^3.13",
		"vlucas/phpdotenv": "^5.6",
		"wp-coding-standards/wpcs": "^3.3"
    },
    "config": {
        "process-timeout" : 0,
		"optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
		"cs": "phpcs",
		"cs:fix": "phpcbf"
	},
	"extra": {
		"scripts-description": {
			"cs": "Run phpcodesniffer",
			"cs:fix": "Run phpcodesniffer beautifier"
		}
	}
}
